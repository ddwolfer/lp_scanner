{
  "name": "lp-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "tsx scanner/run.ts",
    "backfill": "tsx scripts/backfill-pools.ts",
    "sim-check": "tsx scripts/sim-check.ts",
    "probe-alchemy": "tsx scripts/probe-alchemy.ts",
    "serve": "tsx server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "positions": "tsx scripts/sync-positions.ts",
    "costs": "tsx scripts/tx-costs.ts",
    "pool": "tsx scripts/pool-check.ts",
    "range": "tsx scripts/range-check.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
